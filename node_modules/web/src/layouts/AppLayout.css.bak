.erp-layout {
  min-height: 100vh;
  display: flex;
  background: #f4f5f7;
}

.erp-sidebar {
  width: 260px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-right: 1px solid #e5e7eb;
}

.erp-sidebar-header {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 86px;
  padding: 18px 20px;
  border-bottom: 1px solid #e5e7eb;
}

.erp-sidebar-logo {
  width: 44px;
  height: 44px;
  object-fit: contain;
  flex-shrink: 0;
}

.erp-sidebar-title {
  color: #111827;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.erp-sidebar-subtitle {
  margin-top: 3px;
  color: #6b7280;
  font-size: 12px;
}

.erp-navigation {
  flex: 1;
  overflow-y: auto;
  padding: 18px 12px;
}

.erp-menu-group {
  margin-bottom: 4px;
}

.erp-menu-section {
  padding: 13px 12px 6px;
  color: #6b7280;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.erp-menu-children {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.erp-nav-link {
  display: block;
  padding: 10px 12px;
  border-radius: 7px;
  color: #374151;
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.erp-nav-link:hover {
  background: #f3f4f6;
  color: #111827;
}

.erp-nav-link.active {
  background: #e5e7eb;
  color: #111827;
  font-weight: 600;
}

.erp-nav-child {
  padding-left: 24px;
  font-size: 13px;
}

.erp-sidebar-footer {
  padding: 16px 20px;
  border-top: 1px solid #e5e7eb;
}

.erp-user-label {
  margin-bottom: 10px;
  color: #374151;
  font-size: 13px;
  font-weight: 600;
}

.erp-logout-button {
  width: 100%;
  min-height: 38px;
  border: 1px solid #d1d5db;
  border-radius: 7px;
  background: #ffffff;
  color: #374151;
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease;
}

.erp-logout-button:hover {
  background: #f9fafb;
  border-color: #9ca3af;
}

.erp-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.erp-header {
  min-height: 86px;
  display: flex;
  align-items: center;
  padding: 18px 32px;
  background: #ffffff;
  border-bottom: 1px solid #e5e7eb;
}

.erp-header-title {
  color: #111827;
  font-size: 20px;
  font-weight: 700;
}

.erp-header-subtitle {
  margin-top: 3px;
  color: #6b7280;
  font-size: 13px;
}

.erp-content {
  flex: 1;
  padding: 32px;
}

@media (max-width: 900px) {
  .erp-sidebar {
    width: 220px;
  }

  .erp-header {
    padding: 18px 24px;
  }

  .erp-content {
    padding: 24px;
  }
}

@media (max-width: 700px) {
  .erp-layout {
    display: block;
  }

  .erp-sidebar {
    width: 100%;
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .erp-navigation {
    max-height: 45vh;
  }

  .erp-sidebar-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .erp-user-label {
    margin-bottom: 0;
  }

  .erp-logout-button {
    width: auto;
    padding: 0 16px;
  }

  .erp-header {
    min-height: 72px;
    padding: 16px 20px;
  }

  .erp-content {
    padding: 20px;
  }
}

.erp-logout-error {
  margin: 10px 0 0;
  color: #b91c1c;
  font-size: 12px;
  line-height: 1.4;
}
