  updatedAt     DateTime
  alumno        alumno                  @relation(fields: [alumnoId], references: [id], onDelete: Restrict, map: "AlumnoPeriodo_alumnoId_fkey")

  @@index([alumnoId, fechaInicio], map: "AlumnoPeriodo_alumnoId_fechaInicio_idx")
  @@index([alumnoId, fechaFin], map: "AlumnoPeriodo_alumnoId_fechaFin_idx")
}

