model musicoperiodo {
  id            String                  @id @db.Char(36)
  musicoId      String                  @db.Char(36)
  fechaInicio   DateTime                @db.Date
  fechaFin      DateTime?               @db.Date
  motivoBaja    musicoperiodo_motivoBaja?
  observaciones String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime
  musico        musico                  @relation(fields: [musicoId], references: [id], onDelete: Restrict, map: "MusicoPeriodo_musicoId_fkey")

  @@index([musicoId, fechaInicio], map: "MusicoPeriodo_musicoId_fechaInicio_idx")
  @@index([musicoId, fechaFin], map: "MusicoPeriodo_musicoId_fechaFin_idx")
}

