.configuracion-page {
  max-width: 1200px;
  margin: 0 auto;
}

.configuracion-header {
  margin-bottom: 32px;
}

.configuracion-header h1 {
  margin: 0 0 8px;
  font-size: 28px;
}

.configuracion-header p {
  margin: 0;
  color: #667085;
}

.configuracion-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.configuracion-card {
  display: block;
  padding: 24px;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  background: #ffffff;
  color: inherit;
  text-decoration: none;
  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease,
    transform 0.15s ease;
}

.configuracion-card:hover {
  border-color: #bba5d6;
  box-shadow: 0 4px 14px rgba(16, 24, 40, 0.08);
  transform: translateY(-1px);
}

.configuracion-card h2 {
  margin: 0 0 8px;
  font-size: 18px;
}

.configuracion-card p {
  margin: 0;
  color: #667085;
  line-height: 1.5;
}

@media (max-width: 900px) {
  .configuracion-grid {
    grid-template-columns: 1fr;
  }
}
