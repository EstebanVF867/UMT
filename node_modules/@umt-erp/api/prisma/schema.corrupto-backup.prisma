generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model actuacion {
  id                  String                @id @db.Char(36)
  ejercicioId         String                @db.Char(36)
  contratacionId      String?               @db.Char(36)
  fecha               DateTime              @db.Date
  nombre              String                @db.VarChar(200)
  lugar               String?               @db.VarChar(255)
  importeAcordado     Decimal?              @db.Decimal(12, 2)
  observaciones       String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  contratacion        contratacion?         @relation(fields: [contratacionId], references: [id], onDelete: Restrict, map: "Actuacion_contratacionId_fkey")
  ejercicio           ejercicio             @relation(fields: [ejercicioId], references: [id], map: "Actuacion_ejercicioId_fkey")
  actuacionagrupacion actuacionagrupacion[]
  asistencia          asistencia[]
  facturacliente      facturacliente[]
  facturaproveedor    facturaproveedor[]

  @@index([contratacionId], map: "Actuacion_contratacionId_idx")
  @@index([ejercicioId, fecha], map: "Actuacion_ejercicioId_fecha_idx")
}

model actuacionagrupacion {
  id           String     @id @db.Char(36)
  actuacionId  String     @db.Char(36)
  agrupacionId String     @db.Char(36)
  createdAt    DateTime   @default(now())
  actuacion    actuacion  @relation(fields: [actuacionId], references: [id], map: "ActuacionAgrupacion_actuacionId_fkey")
  agrupacion   agrupacion @relation(fields: [agrupacionId], references: [id], map: "ActuacionAgrupacion_agrupacionId_fkey")

  @@unique([actuacionId, agrupacionId], map: "ActuacionAgrupacion_actuacionId_agrupacionId_key")
  @@index([agrupacionId], map: "ActuacionAgrupacion_agrupacionId_idx")
}

model agrupacion {
  id                  String                @id @db.Char(36)
  nombre              String                @db.VarChar(100)
  descripcion         String?               @db.VarChar(255)
  activo              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  actuacionagrupacion actuacionagrupacion[]
  personaagrupacion   personaagrupacion[]
}

model alumno {
  id             String             @id @db.Char(36)
  personaId      String             @unique(map: "Alumno_personaId_key") @db.Char(36)
  fechaAlta      DateTime           @db.Date
  fechaBaja      DateTime?          @db.Date
  motivoBaja     alumno_motivoBaja?
  activo         Boolean            @default(true)
  observaciones  String?            @db.Text
  persona        persona            @relation(fields: [personaId], references: [id], map: "Alumno_personaId_fkey")
    alumnoperiodo   alumnoperiodo[]`r`n  clase          clase[]
  condicioncuota condicioncuota[]
  cuota          cuota[]
}

model asiento {
  id                   String              @id @db.Char(36)
  numero               Int
  ejercicioId          String              @db.Char(36)
  periodoContableId    String?             @db.Char(36)
  fechaContabilizacion DateTime            @db.Date
  concepto             String?             @db.Text
  createdAt            DateTime            @default(now())
  ejercicio            ejercicio           @relation(fields: [ejercicioId], references: [id], map: "Asiento_ejercicioId_fkey")
  periodocontable      periodocontable?    @relation(fields: [periodoContableId], references: [id], onDelete: Restrict, map: "Asiento_periodoContableId_fkey")
  asientomovimiento    asientomovimiento[]
  lineaasiento         lineaasiento[]

  @@unique([ejercicioId, numero], map: "Asiento_ejercicioId_numero_key")
  @@index([fechaContabilizacion], map: "Asiento_fechaContabilizacion_idx")
  @@index([periodoContableId], map: "Asiento_periodoContableId_idx")
}

model asientomovimiento {
  id                     String               @id @db.Char(36)
  asientoId              String               @db.Char(36)
  movimientoFinancieroId String               @db.Char(36)
  createdAt              DateTime             @default(now())
  asiento                asiento              @relation(fields: [asientoId], references: [id], map: "AsientoMovimiento_asientoId_fkey")
  movimientofinanciero   movimientofinanciero @relation(fields: [movimientoFinancieroId], references: [id], map: "AsientoMovimiento_movimientoFinancieroId_fkey")

  @@unique([asientoId, movimientoFinancieroId], map: "AsientoMovimiento_asientoId_movimientoFinancieroId_key")
  @@index([movimientoFinancieroId], map: "AsientoMovimiento_movimientoFinancieroId_idx")
}

model asistencia {
  id            String                   @id @db.Char(36)
  actuacionId   String                   @db.Char(36)
  musicoId      String                   @db.Char(36)
  tipoActividad asistencia_tipoActividad
  estado        asistencia_estado        @default(PROVISIONAL)
  fechaRegistro DateTime
  origen        String?                  @db.VarChar(50)
  observaciones String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime
  actuacion     actuacion                @relation(fields: [actuacionId], references: [id], map: "Asistencia_actuacionId_fkey")
  musico        musico                   @relation(fields: [musicoId], references: [id], map: "Asistencia_musicoId_fkey")

  @@unique([actuacionId, musicoId], map: "Asistencia_actuacionId_musicoId_key")
  @@index([musicoId, fechaRegistro], map: "Asistencia_musicoId_fechaRegistro_idx")
}

model auditlog {
  id          String          @id @db.Char(36)
  userId      String?         @db.Char(36)
  action      auditlog_action
  entity      String          @db.VarChar(100)
  entityId    String?         @db.Char(36)
  description String?         @db.Text
  metadata    String?         @db.LongText
  ipAddress   String?         @db.VarChar(45)
  userAgent   String          @db.VarChar(500)
  createdAt   DateTime        @default(now())
  usuario     usuario?        @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([action], map: "AuditLog_action_idx")
  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@index([entity, entityId], map: "AuditLog_entity_entityId_idx")
  @@index([userId], map: "AuditLog_userId_idx")
}

model aula {
  id          String   @id @db.Char(36)
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.Text
  capacidad   Int?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  clase       clase[]
}

model centroanalitico {
  id               String             @id @db.Char(36)
  codigo           String             @unique(map: "CentroAnalitico_codigo_key") @db.VarChar(50)
  nombre           String             @db.VarChar(150)
  descripcion      String?            @db.Text
  activo           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  facturacliente   facturacliente[]
  facturaproveedor facturaproveedor[]
  lineaasiento     lineaasiento[]
}

model clase {
  id            String       @id @db.Char(36)
  alumnoId      String       @db.Char(36)
  profesorId    String       @db.Char(36)
  materiaId     String       @db.Char(36)
  aulaId        String       @db.Char(36)
  diaSemana     Int
  horaInicio    DateTime     @db.Time(0)
  horaFin       DateTime     @db.Time(0)
  fechaInicio   DateTime     @db.Date
  fechaFin      DateTime?    @db.Date
  estado        clase_estado @default(ACTIVA)
  observaciones String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  alumno        alumno       @relation(fields: [alumnoId], references: [id], map: "Clase_alumnoId_fkey")
  aula          aula         @relation(fields: [aulaId], references: [id], map: "Clase_aulaId_fkey")
  materia       materia      @relation(fields: [materiaId], references: [id], map: "Clase_materiaId_fkey")
  profesor      profesor     @relation(fields: [profesorId], references: [id], map: "Clase_profesorId_fkey")

  @@index([alumnoId, fechaInicio], map: "Clase_alumnoId_fechaInicio_idx")
  @@index([aulaId, fechaInicio], map: "Clase_aulaId_fechaInicio_idx")
  @@index([materiaId], map: "Clase_materiaId_fkey")
  @@index([profesorId, fechaInicio], map: "Clase_profesorId_fechaInicio_idx")
}

model cliente {
  id                 String           @id @db.Char(36)
  nombreRazonSocial  String           @db.VarChar(200)
  nifCif             String?          @db.VarChar(30)
  tipoCliente        String?          @db.VarChar(50)
  personaContacto    String?          @db.VarChar(150)
  telefono           String?          @db.VarChar(30)
  email              String?          @db.VarChar(255)
  direccionFiscal    String?          @db.VarChar(255)
  codigoPostal       String?          @db.VarChar(15)
  localidad          String?          @db.VarChar(100)
  provincia          String?          @db.VarChar(100)
  pais               String?          @db.VarChar(100)
  iban               String?          @db.VarChar(34)
  formaCobro         String?          @db.VarChar(50)
  plazoCobro         String?          @db.VarChar(50)
  observacionesCobro String?          @db.Text
  activo             Boolean          @default(true)
  observaciones      String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  cobro              cobro[]
  contratacion       contratacion[]
  facturacliente     facturacliente[]

  @@index([nifCif], map: "Cliente_nifCif_idx")
  @@index([nombreRazonSocial], map: "Cliente_nombreRazonSocial_idx")
}

model cobro {
  id                     String               @id @db.Char(36)
  fechaCobro             DateTime             @db.Date
  clienteId              String               @db.Char(36)
  importeTotal           Decimal              @db.Decimal(12, 2)
  cuentaFinancieraId     String               @db.Char(36)
  medioPago              cobro_medioPago
  concepto               String               @db.Text
  referencia             String?              @db.VarChar(100)
  observaciones          String?              @db.Text
  movimientoFinancieroId String               @unique(map: "Cobro_movimientoFinancieroId_key") @db.Char(36)
  asientoId              String?              @db.Char(36)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime
  cliente                cliente              @relation(fields: [clienteId], references: [id], map: "Cobro_clienteId_fkey")
  cuentafinanciera       cuentafinanciera     @relation(fields: [cuentaFinancieraId], references: [id], map: "Cobro_cuentaFinancieraId_fkey")
  movimientofinanciero   movimientofinanciero @relation(fields: [movimientoFinancieroId], references: [id], map: "Cobro_movimientoFinancieroId_fkey")
  liquidacioncobro       liquidacioncobro[]

  @@index([clienteId, fechaCobro], map: "Cobro_clienteId_fechaCobro_idx")
  @@index([cuentaFinancieraId], map: "Cobro_cuentaFinancieraId_fkey")
}

model condicioncuota {
  id                String                @id @db.Char(36)
  alumnoId          String                @db.Char(36)
  tipo              condicioncuota_tipo
  valor             Decimal               @db.Decimal(12, 2)
  fechaInicio       DateTime              @db.Date
  fechaFin          DateTime?             @db.Date
  motivo            condicioncuota_motivo
  observaciones     String?               @db.Text
  activa            Boolean               @default(true)
  autorizadaPor     String?               @db.VarChar(150)
  fechaAutorizacion DateTime?             @db.Date
  createdAt         DateTime              @default(now())
  updatedAt         DateTime
  alumno            alumno                @relation(fields: [alumnoId], references: [id], map: "CondicionCuota_alumnoId_fkey")

  @@index([alumnoId, fechaInicio, fechaFin], map: "CondicionCuota_alumnoId_fechaInicio_fechaFin_idx")
}

model contratacion {
  id              String           @id @db.Char(36)
  clienteId       String           @db.Char(36)
  fechaInicio     DateTime         @db.Date
  fechaFin        DateTime?        @db.Date
  descripcion     String           @db.Text
  importeAcordado Decimal?         @db.Decimal(12, 2)
  estado          String           @db.VarChar(30)
  observaciones   String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  actuacion       actuacion[]
  cliente         cliente          @relation(fields: [clienteId], references: [id], map: "Contratacion_clienteId_fkey")
  facturacliente  facturacliente[]

  @@index([clienteId, fechaInicio], map: "Contratacion_clienteId_fechaInicio_idx")
}

model contrato {
  id                  String                @id @db.Char(36)
  profesorId          String                @db.Char(36)
  fechaInicio         DateTime              @db.Date
  fechaFin            DateTime?             @db.Date
  salarioHora         Decimal               @db.Decimal(12, 2)
  periodicidad        contrato_periodicidad
  estado              contrato_estado       @default(ACTIVO)
  observaciones       String?               @db.Text
  nextcloudReferencia String?               @db.VarChar(500)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  profesor            profesor              @relation(fields: [profesorId], references: [id], map: "Contrato_profesorId_fkey")
  nomina              nomina[]

  @@index([profesorId, fechaInicio], map: "Contrato_profesorId_fechaInicio_idx")
}

model cuentacontable {
  id               String                    @id @db.Char(36)
  codigo           String                    @unique(map: "CuentaContable_codigo_key") @db.VarChar(30)
  nombre           String                    @db.VarChar(150)
  tipo             cuentacontable_tipo
  naturaleza       cuentacontable_naturaleza
  nivel            Int
  agrupadora       Boolean                   @default(false)
  movimiento       Boolean                   @default(true)
  fechaInicio      DateTime?                 @db.Date
  fechaFin         DateTime?                 @db.Date
  activa           Boolean                   @default(true)
  observaciones    String?                   @db.Text
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime
  cuentafinanciera cuentafinanciera[]
  facturacliente   facturacliente[]
  facturaproveedor facturaproveedor[]
  lineaasiento     lineaasiento[]

  @@index([nivel], map: "CuentaContable_nivel_idx")
  @@index([tipo, activa], map: "CuentaContable_tipo_activa_idx")
}

model cuentafinanciera {
  id                   String                 @id @db.Char(36)
  tipo                 cuentafinanciera_tipo
  nombre               String                 @db.VarChar(100)
  banco                String?                @db.VarChar(150)
  iban                 String?                @db.VarChar(34)
  moneda               String                 @db.VarChar(3)
  fechaApertura        DateTime?              @db.Date
  fechaCierre          DateTime?              @db.Date
  activa               Boolean                @default(true)
  cuentaContableId     String?                @db.Char(36)
  observaciones        String?                @db.Text
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  cobro                cobro[]
  cuentacontable       cuentacontable?        @relation(fields: [cuentaContableId], references: [id], onDelete: Restrict, map: "CuentaFinanciera_cuentaContableId_fkey")
  movimientofinanciero movimientofinanciero[]
  pago                 pago[]

  @@index([cuentaContableId], map: "CuentaFinanciera_cuentaContableId_fkey")
  @@index([iban], map: "CuentaFinanciera_iban_idx")
  @@index([tipo, activa], map: "CuentaFinanciera_tipo_activa_idx")
}

model cuota {
  id                  String                  @id @db.Char(36)
  alumnoId            String                  @db.Char(36)
  tarifaId            String                  @db.Char(36)
  fecha               DateTime                @db.Date
  importeBase         Decimal                 @db.Decimal(12, 2)
  ajuste              Decimal                 @default(0.00) @db.Decimal(12, 2)
  importeFinal        Decimal                 @db.Decimal(12, 2)
  motivoAjuste        String?                 @db.VarChar(255)
  estado              cuota_estado            @default(PENDIENTE)
  fechaEnvioBanco     DateTime?               @db.Date
  motivoDevolucion    cuota_motivoDevolucion?
  asientoId           String?                 @db.Char(36)
  observaciones       String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime
  alumno              alumno                  @relation(fields: [alumnoId], references: [id], map: "Cuota_alumnoId_fkey")
  tarifa              tarifa                  @relation(fields: [tarifaId], references: [id], map: "Cuota_tarifaId_fkey")
  obligacioneconomica obligacioneconomica?
  remesacuota         remesacuota[]

  @@index([alumnoId, fecha], map: "Cuota_alumnoId_fecha_idx")
  @@index([estado], map: "Cuota_estado_idx")
  @@index([tarifaId], map: "Cuota_tarifaId_idx")
}

model derechocobro {
  id               String             @id @db.Char(36)
  facturaClienteId String             @unique(map: "DerechoCobro_facturaClienteId_key") @db.Char(36)
  importe          Decimal            @db.Decimal(12, 2)
  observaciones    String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  facturacliente   facturacliente     @relation(fields: [facturaClienteId], references: [id], map: "DerechoCobro_facturaClienteId_fkey")
  liquidacioncobro liquidacioncobro[]
}

model director {
  id            String    @id @db.Char(36)
  personaId     String    @unique(map: "Director_personaId_key") @db.Char(36)
  fechaAlta     DateTime  @db.Date
  fechaBaja     DateTime? @db.Date
  activo        Boolean   @default(true)
  observaciones String?   @db.Text
  persona       persona   @relation(fields: [personaId], references: [id], map: "Director_personaId_fkey")
    directorperiodo  directorperiodo[]`r`n}

model ejercicio {
  id                  String                @id @db.Char(36)
  nombre              String                @db.VarChar(50)
  fechaInicio         DateTime              @db.Date
  fechaFin            DateTime              @db.Date
  estado              ejercicio_estado      @default(ABIERTO)
  observaciones       String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  actuacion           actuacion[]
  asiento             asiento[]
  obligacioneconomica obligacioneconomica[]
  periodocontable     periodocontable[]
  reparto             reparto[]

  @@index([fechaInicio, fechaFin], map: "Ejercicio_fechaInicio_fechaFin_idx")
}

model facturacliente {
  id                          String                        @id @db.Char(36)
  clienteId                   String                        @db.Char(36)
  contratacionId              String?                       @db.Char(36)
  actuacionId                 String?                       @db.Char(36)
  numero                      String                        @db.VarChar(100)
  fechaFactura                DateTime                      @db.Date
  vencimiento                 DateTime?                     @db.Date
  concepto                    String                        @db.Text
  base                        Decimal                       @db.Decimal(12, 2)
  iva                         Decimal                       @db.Decimal(12, 2)
  total                       Decimal                       @db.Decimal(12, 2)
  estado                      facturacliente_estado         @default(PENDIENTE)
  asientoId                   String?                       @db.Char(36)
  cuentaContableId            String?                       @db.Char(36)
  centroAnaliticoId           String?                       @db.Char(36)
  observaciones               String?                       @db.Text
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime
  derechocobro                derechocobro?
  actuacion                   actuacion?                    @relation(fields: [actuacionId], references: [id], onDelete: Restrict, map: "FacturaCliente_actuacionId_fkey")
  centroanalitico             centroanalitico?              @relation(fields: [centroAnaliticoId], references: [id], onDelete: Restrict, map: "FacturaCliente_centroAnaliticoId_fkey")
  cliente                     cliente                       @relation(fields: [clienteId], references: [id], map: "FacturaCliente_clienteId_fkey")
  contratacion                contratacion?                 @relation(fields: [contratacionId], references: [id], onDelete: Restrict, map: "FacturaCliente_contratacionId_fkey")
  cuentacontable              cuentacontable?               @relation(fields: [cuentaContableId], references: [id], onDelete: Restrict, map: "FacturaCliente_cuentaContableId_fkey")
  facturarectificativacliente facturarectificativacliente[]

  @@unique([clienteId, numero], map: "FacturaCliente_clienteId_numero_key")
  @@index([actuacionId], map: "FacturaCliente_actuacionId_fkey")
  @@index([centroAnaliticoId], map: "FacturaCliente_centroAnaliticoId_fkey")
  @@index([contratacionId], map: "FacturaCliente_contratacionId_fkey")
  @@index([cuentaContableId], map: "FacturaCliente_cuentaContableId_fkey")
  @@index([estado], map: "FacturaCliente_estado_idx")
  @@index([fechaFactura], map: "FacturaCliente_fechaFactura_idx")
}

model facturaproveedor {
  id                            String                          @id @db.Char(36)
  proveedorId                   String                          @db.Char(36)
  numero                        String                          @db.VarChar(100)
  fechaFactura                  DateTime                        @db.Date
  fechaRegistro                 DateTime                        @db.Date
  vencimiento                   DateTime?                       @db.Date
  concepto                      String                          @db.Text
  base                          Decimal                         @db.Decimal(12, 2)
  iva                           Decimal                         @db.Decimal(12, 2)
  total                         Decimal                         @db.Decimal(12, 2)
  estado                        facturaproveedor_estado         @default(PENDIENTE)
  asientoId                     String?                         @db.Char(36)
  cuentaContableId              String?                         @db.Char(36)
  centroAnaliticoId             String?                         @db.Char(36)
  proyecto                      String?                         @db.VarChar(255)
  actuacionId                   String?                         @db.Char(36)
  observaciones                 String?                         @db.Text
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  actuacion                     actuacion?                      @relation(fields: [actuacionId], references: [id], onDelete: Restrict, map: "FacturaProveedor_actuacionId_fkey")
  centroanalitico               centroanalitico?                @relation(fields: [centroAnaliticoId], references: [id], onDelete: Restrict, map: "FacturaProveedor_centroAnaliticoId_fkey")
  cuentacontable                cuentacontable?                 @relation(fields: [cuentaContableId], references: [id], onDelete: Restrict, map: "FacturaProveedor_cuentaContableId_fkey")
  proveedor                     proveedor                       @relation(fields: [proveedorId], references: [id], map: "FacturaProveedor_proveedorId_fkey")
  facturarectificativaproveedor facturarectificativaproveedor[]
  obligacioneconomica           obligacioneconomica?

  @@unique([proveedorId, numero], map: "FacturaProveedor_proveedorId_numero_key")
  @@index([actuacionId], map: "FacturaProveedor_actuacionId_fkey")
  @@index([centroAnaliticoId], map: "FacturaProveedor_centroAnaliticoId_fkey")
  @@index([cuentaContableId], map: "FacturaProveedor_cuentaContableId_fkey")
  @@index([estado], map: "FacturaProveedor_estado_idx")
  @@index([fechaFactura], map: "FacturaProveedor_fechaFactura_idx")
}

model facturarectificativacliente {
  id                String         @id @db.Char(36)
  facturaOriginalId String         @db.Char(36)
  numero            String         @db.VarChar(100)
  fechaFactura      DateTime       @db.Date
  concepto          String         @db.Text
  base              Decimal        @db.Decimal(12, 2)
  iva               Decimal        @db.Decimal(12, 2)
  total             Decimal        @db.Decimal(12, 2)
  asientoId         String?        @db.Char(36)
  observaciones     String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  facturacliente    facturacliente @relation(fields: [facturaOriginalId], references: [id], map: "FacturaRectificativaCliente_facturaOriginalId_fkey")

  @@unique([facturaOriginalId, numero], map: "FacturaRectificativaCliente_facturaOriginalId_numero_key")
}

model facturarectificativaproveedor {
  id                String           @id @db.Char(36)
  facturaOriginalId String           @db.Char(36)
  numero            String           @db.VarChar(100)
  fechaFactura      DateTime         @db.Date
  concepto          String           @db.Text
  base              Decimal          @db.Decimal(12, 2)
  iva               Decimal          @db.Decimal(12, 2)
  total             Decimal          @db.Decimal(12, 2)
